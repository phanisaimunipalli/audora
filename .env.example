# Server-side only. Loaded by the Vite dev server / node server, never shipped to the browser.
# Leave blank to run Audora in mock mode (simulated reconstruction + heuristic AI).

# Nebius Token Factory (https://docs.tokenfactory.nebius.com) — OpenAI-compatible.
NEBIUS_API_KEY=
# Model ids verified on 2026-09-05 (GET /v1/models). Leave blank for these defaults.
NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
NEBIUS_TEXT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_FAST_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Credit guard for live World Labs generations per server process (default 3).
MARBLE_MAX_GENERATIONS=3

# World Labs Marble (https://docs.worldlabs.ai/api)
WORLDLABS_API_KEY=
MARBLE_DRAFT_MODEL=marble-1.0-draft
MARBLE_FULL_MODEL=marble-1.1
# MARBLE_MOCK=1 makes the backend worker use the built-in mock provider instead of World Labs: the
# whole pipeline runs end to end, costs nothing and needs no key. It is also what happens on its own
# when WORLDLABS_API_KEY is blank. Set it whenever you are testing the pipeline rather than Marble.
MARBLE_MOCK=

# Supabase backend (docs/BACKEND.md). Leave all three blank and /api/v1 answers 503 while the app
# keeps its browser-local store, so nothing existing breaks: the backend is opt-in.
#   local:  supabase start, then supabase db reset (applies supabase/migrations/*)
#   hosted: supabase link --project-ref <ref>, then supabase db push
SUPABASE_URL=
# Server only, never shipped to the browser: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# For the browser client (auth + realtime); public by design.
SUPABASE_ANON_KEY=
# Bump to invalidate every recipe on purpose — every room then regenerates at full cost (default 1).
PIPELINE_VERSION=1
# LOCAL DEVELOPMENT ONLY: act as the owner of this organisation when no access token is sent.
# Ignored when NODE_ENV=production, and a real token always wins over it.
AUDORA_DEV_ORG=

# ShadeMap (https://shademap.app/about/) — browser-side key for the leaflet-shadow-simulator layer that
# draws real terrain + building shadows in the Site step. VITE_ prefix is intentional: the library runs in
# the browser and the key is domain-restricted at ShadeMap. Leave blank to fall back to Audora's own solar model.
VITE_SHADEMAP_KEY=

# Staging model. Default: the hosted Qwen3-235B on Token Factory (product decision 2026-09-06).
# Point at the fine-tuned 8B only when it is hosted somewhere, e.g. STAGER_MODEL=modal:stager
STAGER_MODEL=

# Optional: OpenAI-compatible providers used only to serve fine-tuned checkpoints for A/B evaluation
# (model ids prefixed together: / fireworks: / openai: in EVAL_MODELS route there). The product's main flow stays on Token Factory.
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=
# Self-hosted vLLM for the fine-tuned stager (scripts/serve-lora-modal.py): model id "modal:stager" in EVAL_MODELS
MODAL_BASE_URL=
MODAL_API_KEY=
