{
  "name": "audora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "audora": "dist-server/server/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "postbuild": "node scripts/link-bin.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "eval": "vitest run --config vitest.eval.config.ts",
    "start": "node dist-server/server/prod.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sparkjsdev/spark": "^2.1.0",
    "@types/leaflet": "^1.9.22",
    "framer-motion": "^13.2.0",
    "leaflet": "^1.9.4",
    "leaflet-shadow-simulator": "^0.67.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
